# Build Rust library for FFI
rust_library(
    name = "core",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["PUBLIC"],
)

# Generate C header from Rust using cbindgen
genrule(
    name = "cbindgen_headers",
    srcs = glob(["src/**/*.rs", "cbindgen.toml", "Cargo.toml", "Cargo.lock"]),
    out = "core.h",
    bash = "cd $SRCDIR && cbindgen --config cbindgen.toml --crate core --lang c --output $OUT",
    cmd_exe = "cd %SRCDIR% && cbindgen --config cbindgen.toml --crate core --lang c --output %OUT%",
    visibility = ["PUBLIC"],
)

# Expose the Rust library as a C-compatible prebuilt library
prebuilt_cxx_library(
    name = 'cbindgen_core',
    soname = 'libcore.so',
    static_lib = ':core[staticlib]',
    shared_lib = ':core[cdylib]',
    exported_headers = [
        ':cbindgen_headers',
    ],
    visibility = ["PUBLIC"],
)
